<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="10dp" android:background="@drawable/royal_card" android:minHeight="76dp">
<ImageView android:id="@+id/row_icon" android:layout_width="30dp" android:layout_height="34dp" android:layout_marginEnd="8dp" android:src="@drawable/gondor_shield" android:contentDescription="@null"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:id="@+id/row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:fontFamily="serif" android:textColor="#F4E6BE" android:maxLines="2" android:ellipsize="end"/>
<TextView android:id="@+id/row_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#E4EAF2" android:layout_marginTop="4dp" android:maxLines="6" android:ellipsize="end"/>
</LinearLayout></LinearLayout>